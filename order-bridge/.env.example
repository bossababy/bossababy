# =========================================================
# Copy to .env for local work; in production set these as
# environment variables in the Vercel dashboard.
#
# NEVER commit real values. This repository is public — a
# leaked 3PL key lets a stranger create or cancel shipments,
# and a leaked Shopify token exposes customer addresses.
# =========================================================

# ---- Shopify ----
# Your permanent myshopify domain, not the custom domain.
SHOPIFY_SHOP_DOMAIN=bossababy.myshopify.com

# Admin API access token from the custom app (starts with shpat_).
# Scopes needed: read_orders, write_orders.
SHOPIFY_ADMIN_TOKEN=

# Shown once when you create the webhook. Used to prove that an
# incoming order really came from Shopify.
SHOPIFY_WEBHOOK_SECRET=

# ---- 3PL ----
THREEPL_API_URL=https://api.your-3pl.example/v1/orders
THREEPL_API_KEY=

# bearer (default) | apikey | basic
THREEPL_AUTH_STYLE=bearer
# Only for THREEPL_AUTH_STYLE=apikey
THREEPL_API_KEY_HEADER=X-API-Key
# Only for THREEPL_AUTH_STYLE=basic
THREEPL_API_USER=

# ---- Behaviour ----
# true while pre-selling with no stock: orders are tagged and parked
# instead of being sent to the warehouse. Set to false on launch day.
HOLD_PREORDERS=true

# Long random string guarding the release endpoint.
# Generate with: openssl rand -hex 32
RELEASE_TOKEN=
