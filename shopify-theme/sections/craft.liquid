<section class="craft">
  <div class="craft-inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="craft-copy">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="craft-footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Craft",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made by hand" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every bag is made by hand."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Say what is actually done by hand — cut, stitched, finished. Specifics are more convincing, and easier to stand behind, than the word handmade on its own.",
      "default": "<p>Not stamped out by a machine. Each Structured Tote is cut, stitched and finished by hand, which is why the quilting lines meet the way they do and why no two are quite identical.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Note under the copy",
      "default": "A first run of 300, made to a standard we could not reach any faster."
    }
  ],
  "presets": [{ "name": "Craft" }]
}
{% endschema %}
