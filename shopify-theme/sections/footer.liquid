<footer class="site-footer">
  {%- if section.settings.logo -%}
    <img
      class="logo-img small"
      src="{{ section.settings.logo | image_url: width: 320 }}"
      alt="{{ shop.name | escape }}"
      width="160">
  {%- endif -%}

  <nav class="social-links" aria-label="{{ 'general.social.label' | t }}">
    {%- if section.settings.instagram != blank -%}
      <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
      </a>
    {%- endif -%}
    {%- if section.settings.tiktok != blank -%}
      <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M16.6 3c.4 2.1 1.8 3.6 3.9 3.9v3c-1.5 0-2.8-.5-3.9-1.3v6.2c0 3.4-2.5 5.9-5.8 5.9-3.2 0-5.8-2.6-5.8-5.8 0-3.3 2.7-5.9 6.1-5.7v3.1c-.2 0-.5-.1-.7-.1-1.5 0-2.7 1.2-2.7 2.7s1.2 2.7 2.7 2.7c1.6 0 2.9-1.2 2.9-2.9V3h3.3z"/></svg>
      </a>
    {%- endif -%}
  </nav>

  {%- if section.settings.contact_email != blank -%}
    <p class="footer-contact">
      {{ 'general.footer.contact_prefix' | t }}
      <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
    </p>
  {%- endif -%}

  {%- if section.settings.menu != blank -%}
    <nav class="footer-links" aria-label="{{ 'general.footer.policies' | t }}">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; {{ section.settings.tagline }}</p>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Wordmark logo" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@bossababy.ca" },
    { "type": "link_list", "id": "menu", "label": "Policy menu" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "bossababy.ca · Designed in Canada" }
  ]
}
{% endschema %}
