<section class="hero">
  <div class="hero-inner">
    {%- if section.settings.body != blank -%}
      <div class="lede">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a
        class="btn"
        href="{% if section.settings.cta_product != blank %}{{ section.settings.cta_product.url }}{% else %}{{ section.settings.cta_url | default: routes.all_products_collection_url }}{% endif %}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}

    {%- if section.settings.cta_note != blank -%}
      <p class="signup-note">{{ section.settings.cta_note }}</p>
    {%- endif -%}
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Intro",
  "settings": [
    {
      "type": "richtext",
      "id": "body",
      "label": "Opening copy",
      "default": "<p>Clean lines. Considered details. Luxury-grade vegan materials.</p><p>The Structured Tote holds the small chaos of a day with a baby, and gives nothing away.</p>"
    },
    { "type": "product", "id": "cta_product", "label": "Button links to product" },
    { "type": "url", "id": "cta_url", "label": "Or link to a URL" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Pre-order now" },
    {
      "type": "richtext",
      "id": "cta_note",
      "label": "Note under the button",
      "default": "<p><strong>Early-access pre-orders ship first.</strong> Reserve yours today.</p>"
    }
  ],
  "presets": [{ "name": "Intro" }]
}
{% endschema %}
