<div class="cart">
  <h1>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <p>{{ 'cart.empty' | t }}</p>
      <p style="margin-top:1.5rem">
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </p>
    </div>
  {%- else -%}
    {%- comment -%} Detect pre-order line items via the Ships property {%- endcomment -%}
    {%- assign ships_key = 'product.ships_property' | t -%}
    {%- assign has_preorder = false -%}
    {%- assign preorder_date = '' -%}
    {%- for item in cart.items -%}
      {%- assign ship_val = item.properties[ships_key] -%}
      {%- if ship_val == blank -%}
        {%- assign ship_val = item.properties['Ships'] -%}
      {%- endif -%}
      {%- if ship_val != blank -%}
        {%- assign has_preorder = true -%}
        {%- assign preorder_date = ship_val -%}
      {%- endif -%}
    {%- endfor -%}

    <form action="{{ routes.cart_url }}" method="post">
      {%- for item in cart.items -%}
        <div class="cart-line">
          <div>
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="96" loading="lazy">
            {%- endif -%}
          </div>

          <div>
            <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>

            {%- unless item.variant.title contains 'Default' -%}
              <div class="cart-line__variant">{{ item.variant.title }}</div>
            {%- endunless -%}

            {%- if item.properties != blank -%}
              <div class="cart-line__props">
                {%- for property in item.properties -%}
                  {%- unless property.last == blank or property.first[0] == '_' -%}
                    {{ property.first }}: {{ property.last }}<br>
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="cart-line__qty">
              <label class="visually-hidden" for="qty-{{ forloop.index }}">{{ 'product.quantity' | t }}</label>
              <input
                id="qty-{{ forloop.index }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                inputmode="numeric">
              <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
          </div>

          <div class="cart-line__price">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}

      <div class="cart-foot">
        <p class="cart-total">
          {{ 'cart.subtotal' | t }}: <strong>{{ cart.total_price | money_with_currency }}</strong>
        </p>
        {%- comment -%}
          Show what the bag costs without the pre-order discount, so the
          saving is visible at the moment of deciding rather than only
          implied by a percentage elsewhere on the page.
        {%- endcomment -%}
        {%- if cart.original_total_price > cart.total_price -%}
          <p class="cart-was">
            <s>{{ cart.original_total_price | money_with_currency }}</s>
          </p>
        {%- endif -%}
        <p class="cart-note">{{ 'cart.tax_note' | t }}</p>

        {%- if has_preorder -%}
          <div class="preorder-ack">
            <input type="hidden" name="attributes[Pre-order acknowledged]" value="No">
            <input
              type="checkbox"
              id="preorder-ack"
              name="attributes[Pre-order acknowledged]"
              value="Yes"
              required>
            <label for="preorder-ack">{{ 'product.preorder_terms' | t: date: preorder_date }}</label>
          </div>
        {%- endif -%}

        <button type="submit" name="update" class="btn btn--outline" formnovalidate>{{ 'cart.update' | t }}</button>
        <button
          type="submit"
          name="checkout"
          class="btn"
          {% if has_preorder %}data-requires-ack{% endif %}>{{ 'cart.checkout' | t }}</button>
      </div>
    </form>

    {%- if has_preorder -%}
      <style>
        .preorder-ack {
          display: flex;
          align-items: flex-start;
          gap: .75rem;
          margin: 1.5rem 0;
          padding: 1rem 1.25rem;
          border: 1px solid rgba(0, 0, 0, .16);
          border-radius: 4px;
          text-align: left;
        }
        .preorder-ack input[type="checkbox"] {
          flex: 0 0 auto;
          margin-top: .3rem;
        }
        .preorder-ack label {
          font-size: .9rem;
          line-height: 1.55;
        }
        .btn[disabled] {
          opacity: .45;
          cursor: not-allowed;
        }
      </style>

      <script>
        (function () {
          var box = document.getElementById('preorder-ack');
          var btn = document.querySelector('[name="checkout"][data-requires-ack]');
          if (!box || !btn) return;
          function sync() { btn.disabled = !box.checked; }
          box.addEventListener('change', sync);
          sync();
        })();
      </script>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
