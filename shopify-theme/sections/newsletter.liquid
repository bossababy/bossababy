<section class="hero">
  <div class="hero-inner">
    {%- if section.settings.heading != blank -%}
      <h2 style="font-family:var(--font-display);font-weight:500;font-size:clamp(1.6rem,4vw,2.2rem);margin-bottom:1rem">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- form 'customer', id: 'newsletter-form', class: 'signup' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,{{ request.locale.iso_code }}">
      <label class="visually-hidden" for="newsletter-email">{{ 'newsletter.email_label' | t }}</label>
      <input
        id="newsletter-email"
        type="email"
        name="contact[email]"
        placeholder="{{ 'newsletter.placeholder' | t }}"
        autocomplete="email"
        required>
      <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
    {%- endform -%}

    {%- if form.posted_successfully? -%}
      <p class="signup-message success">{{ 'newsletter.success' | t }}</p>
    {%- elsif form.errors -%}
      <p class="signup-message error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="signup-note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p><strong>Early access comes with 20% off</strong> — applied automatically at checkout. No spam, ever.</p>"
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
