{%- if section.settings.eyebrow != blank -%}
  <p class="eyebrow eyebrow-banner">{{ section.settings.eyebrow }}</p>
{%- endif -%}

<div
  class="hero-photo"
  {% if section.settings.image %}
    style="background-image:url({{ section.settings.image | image_url: width: 2000 }});background-position:center {{ section.settings.focal_y }}%;"
    role="img"
    aria-label="{{ section.settings.image_alt | escape }}"
  {% endif %}>
  <div class="hero-photo-copy">
    {%- comment -%}
      A set wordmark replaces the typed headline, but the headline text is
      still what the image is labelled with: search engines and screen
      readers get the same words either way.
    {%- endcomment -%}
    <h1>
      {%- if section.settings.heading_image -%}
        <img
          class="hero-wordmark"
          src="{{ section.settings.heading_image | image_url: width: 1400 }}"
          alt="{{ section.settings.heading_line_1 }} {{ section.settings.heading_line_2 }}"
          width="{{ section.settings.heading_image.width }}"
          height="{{ section.settings.heading_image.height }}">
      {%- else -%}
        {{ section.settings.heading_line_1 }}
        {%- if section.settings.heading_line_2 != blank -%}
          <br><em>{{ section.settings.heading_line_2 }}</em>
        {%- endif -%}
      {%- endif -%}
    </h1>
  </div>
</div>

{% schema %}
{
  "name": "Photo masthead",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Line above photo", "default": "Launching Fall 2026 · Designed in Canada" },
    { "type": "image_picker", "id": "image", "label": "Background photo" },
    { "type": "text", "id": "image_alt", "label": "Photo description (accessibility)", "default": "A mother walking hand in hand with her toddler, the Bossababy bag on her arm" },
    { "type": "range", "id": "focal_y", "label": "Vertical focal point", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "image_picker", "id": "heading_image", "label": "Headline as an image", "info": "Optional. Replaces the typed headline below, which is still used as the image description." },
    { "type": "text", "id": "heading_line_1", "label": "Headline, first line", "default": "Carry everything." },
    { "type": "text", "id": "heading_line_2", "label": "Headline, second line (italic)", "default": "Compromise nothing." }
  ],
  "presets": [{ "name": "Photo masthead" }]
}
{% endschema %}
