{%- comment -%}
  Homepage opener: the bag in use, the price and the button on the
  first screen. On phones the video fills the screen with the copy over
  its lower edge; on wider screens the portrait video sits beside the copy
  rather than being blown up and cropped to landscape.
{%- endcomment -%}
{%- assign product = section.settings.product -%}

<section class="video-hero">
  <div class="video-hero__media">
    {%- if section.settings.video -%}
      {% render 'brand-video', video: section.settings.video %}
    {%- elsif section.settings.poster -%}
      <img
        src="{{ section.settings.poster | image_url: width: 1080 }}"
        alt=""
        width="{{ section.settings.poster.width }}"
        height="{{ section.settings.poster.height }}">
    {%- endif -%}
  </div>

  <div class="video-hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1>
      {%- if section.settings.heading_image -%}
        <img
          class="hero-wordmark"
          src="{{ section.settings.heading_image | image_url: width: 1400 }}"
          alt="{{ section.settings.heading_line_1 }} {{ section.settings.heading_line_2 }}"
          width="{{ section.settings.heading_image.width }}"
          height="{{ section.settings.heading_image.height }}">
      {%- else -%}
        {{ section.settings.heading_line_1 }}
        {%- if section.settings.heading_line_2 != blank -%}
          <br><em>{{ section.settings.heading_line_2 }}</em>
        {%- endif -%}
      {%- endif -%}
    </h1>

    {%- if section.settings.lede != blank -%}
      <p class="video-hero__lede">{{ section.settings.lede }}</p>
    {%- endif -%}

    {%- if product != blank -%}
      <p class="video-hero__price">{% render 'preorder-price', price: product.price %}</p>
      <a class="btn" href="{{ product.url }}" data-sticky-trigger>
        {{- section.settings.cta_label | default: product.title -}}
      </a>
    {%- endif -%}

    {%- if section.settings.cta_note != blank -%}
      <div class="video-hero__note">{{ section.settings.cta_note }}</div>
    {%- endif -%}
  </div>
</section>

{%- if product != blank -%}
  {% render 'sticky-buy', product: product %}
{%- endif -%}

{% schema %}
{
  "name": "Video hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop; visitors can turn the sound on. Vertical (9:16) works best." },
    { "type": "image_picker", "id": "poster", "label": "Image if there is no video" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the headline", "default": "Pre-order now · Ships Winter 2026" },
    { "type": "image_picker", "id": "heading_image", "label": "Headline as an image", "info": "Optional. Replaces the typed headline below, which is still used as the image description." },
    { "type": "text", "id": "heading_line_1", "label": "Headline, first line", "default": "Carry everything." },
    { "type": "text", "id": "heading_line_2", "label": "Headline, second line (italic)", "default": "Compromise nothing." },
    { "type": "text", "id": "lede", "label": "Line under the headline" },
    { "type": "product", "id": "product", "label": "Product", "info": "Its pre-order price and a button to it are shown." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Pre-order now" },
    { "type": "richtext", "id": "cta_note", "label": "Note under the button" }
  ],
  "presets": [{ "name": "Video hero" }]
}
{% endschema %}
